# Copy to .env for local development. Never commit .env.
# Names only. Values are set locally or in the Render dashboard, never in the repo.

NODE_ENV=development
PORT=3000
# true only behind a proxy you trust (Render). Leave false locally.
TRUST_PROXY=false
# optional: sign-in attempts allowed per IP address per 5 minutes (default 10)
# AUTH_IP_LIMIT=10

# Phase 2: Neon pooled connection strings (Singapore, aws-ap-southeast-1)
# dev branch for local development
DATABASE_URL=
# test branch for automated tests (the tests wipe this database)
TEST_DATABASE_URL=

# Phase 2: seed-time only. Master's first password/PIN (must_change=true on first login)
MASTER_INITIAL_PASSWORD=
MASTER_INITIAL_PIN=

# Phase 3: server-side pepper for PIN hashing (32+ random bytes, base64)
PIN_PEPPER=

# Phase 4: Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
